{
  "name": "gurt-export",
  "version": "1.1.2",
  "description": "A Discord Chat Exporter library and CLI written in TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "gurt-export": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/cli.js --target node --minify",
    "dev": "bun run src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "discord",
    "chat",
    "export",
    "cli",
    "typescript",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "bumpp": "^10.3.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@optique/core": "^0.7.2",
    "@optique/run": "^0.7.2",
    "ky": "^1.14.0"
  }
}
